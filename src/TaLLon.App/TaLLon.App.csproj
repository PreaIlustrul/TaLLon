<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TaLLon.App</RootNamespace>
    <AssemblyName>TaLLon</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TaLLon.ico</ApplicationIcon>
    <NoWarn>CA1416;WFO1000</NoWarn>
    <Version>0.2.0</Version>
    <Authors>TaLLon contributors</Authors>
    <Product>TaLLon</Product>
    <AssemblyTitle>TaLLon</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaLLon.Core\TaLLon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\default-bg.png" />
    <Resource Include="Assets\TaLLon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
