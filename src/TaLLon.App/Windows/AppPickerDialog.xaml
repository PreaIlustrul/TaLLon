<Window x:Class="TaLLon.App.Windows.AppPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose an app" Width="520" Height="560" MinWidth="400" MinHeight="380"
        Background="{StaticResource B.Bg1}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="Search" FontSize="14" Margin="0,0,0,10" />
        <ListBox x:Name="List" Grid.Row="1" Background="{StaticResource B.Bg0}" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                 ItemContainerStyle="{StaticResource MenuListItem}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Browse for a file…" Click="Browse_Click" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Choose" Style="{StaticResource Btn.Primary}" Width="100" Click="Choose_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
