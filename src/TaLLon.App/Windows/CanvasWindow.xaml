<Window x:Class="TaLLon.App.Windows.CanvasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaLLon" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Background="#161A1F" Visibility="Hidden">
    <Grid x:Name="Root" Background="Transparent">
        <Image x:Name="Bg" Stretch="UniformToFill" />
        <Border x:Name="Hint" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20"
                Background="#88000000" CornerRadius="6" Padding="12,6">
            <TextBlock x:Name="HintText" Foreground="#CCFFFFFF" FontSize="12" FontFamily="Segoe UI" />
        </Border>
        <TextBlock Text="TaLLon" Foreground="#33FFFFFF" FontSize="14" FontFamily="Segoe UI" FontWeight="SemiBold"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,22" />
    </Grid>
</Window>
