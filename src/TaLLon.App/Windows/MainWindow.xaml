<Window x:Class="TaLLon.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaLLon" Width="940" Height="680" MinWidth="760" MinHeight="500"
        Background="{StaticResource B.Bg1}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- left nav -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource B.Bg0}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="16,18,0,14">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource B.Bg3}" Margin="0,0,10,0">
                            <TextBlock Text="T" Foreground="{StaticResource B.Accent}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="TaLLon" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="LaunchBtn" Content="Launch TaLLon" Style="{StaticResource Btn.Primary}" Margin="12,0,12,14" Height="38" FontSize="14" Click="Launch_Click" />
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="General" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavKeys" Style="{StaticResource NavItem}" Content="Key bindings" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavLaunchers" Style="{StaticResource NavItem}" Content="App launchers" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavMenu" Style="{StaticResource NavItem}" Content="Menu" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Content="Appearance &amp; layout" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavItem}" Content="Diagnostics" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="About" Checked="Nav_Checked" />
                </StackPanel>
                <TextBlock x:Name="EnvState" DockPanel.Dock="Bottom" Style="{StaticResource T.Dim}" Margin="16,0,12,14" VerticalAlignment="Bottom" />
            </DockPanel>
        </Border>

        <!-- content -->
        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10">
            <Grid>
                <StackPanel x:Name="PageGeneral" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource T.H1}" Text="General" />

                    <TextBlock Style="{StaticResource T.H2}" Text="SPECIAL KEY" />
                    <TextBlock Style="{StaticResource T.Dim}" Text="Tap the special key on its own to open or close the TaLLon environment. Hold it and press another key to run a command (Special+Space = menu)." />
                    <RadioButton x:Name="SpecialCopilot" Content="Copilot key  (LWin + LShift + F23)" Foreground="{StaticResource B.Text}" Margin="0,10,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SpecialOther" Content="Other key:" Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
                        <ComboBox x:Name="SpecialKeyCombo" Width="160" Margin="10,0,0,0" />
                    </StackPanel>
                    <CheckBox x:Name="TapToggles" Content="Tapping the special key alone opens / closes the environment" Margin="0,10,0,0" />

                    <TextBlock Style="{StaticResource T.H2}" Text="ENVIRONMENT" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Open in" VerticalAlignment="Center" Width="200" />
                        <ComboBox x:Name="DefaultMode" Width="160" />
                    </StackPanel>
                    <CheckBox x:Name="HideTaskbar" Content="Hide the Windows taskbar while TaLLon is active" Margin="0,8,0,0" />

                    <TextBlock Style="{StaticResource T.H2}" Text="APP" />
                    <CheckBox x:Name="CloseToTray" Content="Closing this window keeps TaLLon running in the tray" />
                    <CheckBox x:Name="StartWithWindows" Content="Start TaLLon when I sign in (in the tray, environment closed)" />

                    <TextBlock Style="{StaticResource T.H2}" Text="TERMINAL" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Command" VerticalAlignment="Center" />
                        <TextBox x:Name="TerminalCommand" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="Arguments" VerticalAlignment="Center" />
                        <TextBox x:Name="TerminalArgs" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="PageKeys" MaxWidth="640" HorizontalAlignment="Left" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource T.H1}" Text="Key bindings" />
                    <TextBlock Style="{StaticResource T.Dim}" Text="Click a box and press a key (with Ctrl/Shift/Alt if you like). 'Special' means the special key must be held. Save applies instantly." />
                    <StackPanel x:Name="KeysPanel" Margin="0,12,0,0" />
                </StackPanel>

                <StackPanel x:Name="PageLaunchers" MaxWidth="760" HorizontalAlignment="Left" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource T.H1}" Text="App launchers" />
                    <TextBlock Style="{StaticResource T.Dim}" Text="Bind a key combination to any program, file or URL. 'Browse' lists everything installed on this PC, searchable by name." />
                    <StackPanel x:Name="LaunchersPanel" Margin="0,12,0,0" />
                    <Button x:Name="AddLauncher" Content="+ Add launcher" HorizontalAlignment="Left" Margin="0,10,0,0" Click="AddLauncher_Click" />
                </StackPanel>

                <StackPanel x:Name="PageMenu" MaxWidth="640" HorizontalAlignment="Left" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource T.H1}" Text="Menu" />
                    <TextBlock Style="{StaticResource T.Dim}" Text="Apps pinned here appear at the top of the command menu (Special+Space), so you can open them without scrolling or searching." />
                    <TextBlock Style="{StaticResource T.H2}" Text="PINNED APPS" />
                    <StackPanel x:Name="PinnedPanel" />
                    <Button Content="+ Pin an app…" HorizontalAlignment="Left" Margin="0,10,0,0" Click="AddPinned_Click" />
                </StackPanel>

                <StackPanel x:Name="PageAppearance" MaxWidth="640" HorizontalAlignment="Left" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource T.H1}" Text="Appearance &amp; layout" />
                    <TextBlock Style="{StaticResource T.H2}" Text="CANVAS BACKGROUND" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="BgImage" />
                        <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="BrowseBg_Click" />
                        <Button Grid.Column="2" Content="Default" Margin="6,0,0,0" Click="DefaultBg_Click" />
                    </Grid>
                    <Border Margin="0,10,0,0" Height="150" Width="267" HorizontalAlignment="Left" CornerRadius="6" BorderBrush="{StaticResource B.Line}" BorderThickness="1" ClipToBounds="True">
                        <Image x:Name="BgPreview" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Fallback colour" VerticalAlignment="Center" Width="200" />
                        <TextBox x:Name="BgColor" Width="120" />
                    </StackPanel>
                    <CheckBox x:Name="ShowTopBar" Content="Show the top bar (coordinates, menu, clock, battery, …)" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Focused window border" VerticalAlignment="Center" Width="200" />
                        <TextBox x:Name="FocusColor" Width="120" />
                        <TextBlock Text="thickness" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox x:Name="FocusThickness" Width="50" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource T.H2}" Text="INFINITE MODE" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="New window size" VerticalAlignment="Center" />
                        <TextBox x:Name="NewWindowFraction" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Column="2" Style="{StaticResource T.Dim}" Text="1/N of the screen area (default 12)" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Cascade offset (px)" VerticalAlignment="Center" />
                        <TextBox x:Name="CascadeOffset" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="2" Text="Edge pan speed" VerticalAlignment="Center" />
                        <TextBox x:Name="EdgePanSpeed" Grid.Row="2" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource T.Dim}" Text="px per tick (60/s) while the mouse touches an edge" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Text="Edge pan margin (px)" VerticalAlignment="Center" />
                        <TextBox x:Name="EdgePanMargin" Grid.Row="3" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource T.Dim}" Text="0 disables edge panning" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Text="Scroll pan step (px)" VerticalAlignment="Center" />
                        <TextBox x:Name="ScrollPanStep" Grid.Row="4" Grid.Column="1" Margin="0,3" />
                    </Grid>

                    <TextBlock Style="{StaticResource T.H2}" Text="TILING MODE" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Master area width" VerticalAlignment="Center" />
                        <Slider x:Name="MasterRatio" Grid.Column="1" Minimum="0.2" Maximum="0.8" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock x:Name="MasterRatioText" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Gap between windows (px)" VerticalAlignment="Center" />
                        <TextBox x:Name="Gap" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,3" />
                        <TextBlock Grid.Row="2" Text="Master windows" VerticalAlignment="Center" />
                        <TextBox x:Name="MasterCount" Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,3" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="PageDiagnostics" MaxWidth="700" HorizontalAlignment="Left" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource T.H1}" Text="Diagnostics" />
                    <TextBlock Style="{StaticResource T.H2}" Text="RECOVERY" />
                    <TextBlock Style="{StaticResource T.Dim}" Text="If the desktop ever looks wrong after TaLLon (missing taskbar, windows off-screen), this puts everything back." />
                    <Button Content="Restore desktop now" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Restore_Click" />
                    <TextBlock Style="{StaticResource T.H2}" Text="KEY EVENTS" />
                    <TextBlock Style="{StaticResource T.Dim}" Text="Shows what your keyboard really sends. Useful to check the Copilot key or a touchpad gesture mapped to a shortcut." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                        <CheckBox x:Name="TraceKeys" Content="Show raw key events" Checked="Trace_Changed" Unchecked="Trace_Changed" />
                        <Button Content="Clear" Margin="16,0,0,0" Padding="10,2" Click="ClearLog_Click" />
                    </StackPanel>
                    <TextBox x:Name="KeyLog" Height="220" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" />
                    <TextBlock Style="{StaticResource T.H2}" Text="FILES" />
                    <TextBlock x:Name="ConfigPathText" Style="{StaticResource T.Dim}" />
                    <Button Content="Open config / log folder" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenFolder_Click" />
                </StackPanel>

                <StackPanel x:Name="PageAbout" MaxWidth="640" HorizontalAlignment="Left" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource T.H1}" Text="About TaLLon" />
                    <TextBlock Style="{StaticResource T.Dim}" Text="An on-demand window manager for Windows 11. Tap the special key and the desktop becomes an infinite canvas (or a tiling grid); tap again and everything is back where it was." />
                    <TextBlock Style="{StaticResource T.H2}" Text="VERSION" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource T.Dim}" />
                    <TextBlock Style="{StaticResource T.H2}" Text="SOURCE" />
                    <TextBlock Style="{StaticResource T.Dim}" Text="github.com/PreaIlustrul/TaLLon — MIT licence" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- bottom bar -->
        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource B.Bg0}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <TextBlock x:Name="Status" Style="{StaticResource T.Dim}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Revert" Margin="0,0,8,0" Click="Revert_Click" />
                    <Button Content="Save" Style="{StaticResource Btn.Primary}" Width="100" Click="Save_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
