<Window x:Class="TaLLon.App.Windows.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaLLon" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True" Width="680" Height="520"
        Visibility="Hidden">
    <Border Background="#F2222222" BorderBrush="#FF444444" BorderThickness="1" CornerRadius="10" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.7" />
        </Border.Effect>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="Search" Grid.Row="0" FontSize="16" Padding="12,9" Margin="0,0,0,8"
                     BorderThickness="0" Background="#FF1A1A1A" />
            <ListBox x:Name="List" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource MenuListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="#FF8A8A8A" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding Hint}" Foreground="#FF8A8A8A" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2" Text="↑↓ navigate   Enter run   Esc close" Foreground="#FF6E6E6E" FontSize="11" Margin="8,8,0,2" />
        </Grid>
    </Border>
</Window>
