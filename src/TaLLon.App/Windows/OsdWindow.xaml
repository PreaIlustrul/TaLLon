<Window x:Class="TaLLon.App.Windows.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaLLon OSD" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True" SizeToContent="WidthAndHeight"
        Visibility="Hidden">
    <Border Background="#E6202020" BorderBrush="#FF4C9BE8" BorderThickness="1" CornerRadius="8" Padding="18,9" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Icon" Text="⌘" Foreground="#FF4C9BE8" FontSize="14" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock x:Name="Text" Foreground="#FFEDEDED" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
