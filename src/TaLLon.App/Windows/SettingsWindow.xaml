<Window x:Class="TaLLon.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaLLon Settings" Width="900" Height="640" MinWidth="720" MinHeight="480"
        Background="{StaticResource B.Bg1}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- left nav -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource B.Bg0}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,1,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="16,18,0,18">
                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource B.Bg3}" Margin="0,0,10,0">
                        <TextBlock Text="T" Foreground="{StaticResource B.Accent}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="TaLLon" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="General" IsChecked="True" Checked="Nav_Checked" />
                <RadioButton x:Name="NavKeys" Style="{StaticResource NavItem}" Content="Key bindings" Checked="Nav_Checked" />
                <RadioButton x:Name="NavLaunchers" Style="{StaticResource NavItem}" Content="App launchers" Checked="Nav_Checked" />
                <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Content="Appearance &amp; layout" Checked="Nav_Checked" />
                <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="About" Checked="Nav_Checked" />
            </StackPanel>
        </Border>

        <!-- content -->
        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="28,22,28,10">
            <Grid>
                <StackPanel x:Name="PageGeneral" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource T.H1}" Text="General" />

                    <TextBlock Style="{StaticResource T.H2}" Text="SPECIAL KEY" />
                    <TextBlock Style="{StaticResource T.Dim}" Text="Every TaLLon command is Special + another key. Hold it like a modifier, or tap it and press the next key within the leader timeout." />
                    <RadioButton x:Name="SpecialCopilot" Content="Copilot key  (LWin + LShift + F23)" Foreground="{StaticResource B.Text}" Margin="0,10,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SpecialOther" Content="Other key:" Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
                        <ComboBox x:Name="SpecialKeyCombo" Width="160" Margin="10,0,0,0" IsEditable="True" />
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Leader timeout (ms)" VerticalAlignment="Center" />
                        <TextBox x:Name="LeaderTimeout" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Column="2" Style="{StaticResource T.Dim}" Text="After a tap, how long to wait for the command key." Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Tap threshold (ms)" VerticalAlignment="Center" />
                        <TextBox x:Name="TapThreshold" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource T.Dim}" Text="A press shorter than this counts as a tap." Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Style="{StaticResource T.H2}" Text="WHEN TALLON OPENS" />
                    <CheckBox x:Name="HideTaskbar" Content="Hide the Windows taskbar while TaLLon is active" />
                    <CheckBox x:Name="MinimizeOthers" Content="Minimize existing windows (restored when you exit)" />

                    <TextBlock Style="{StaticResource T.H2}" Text="TERMINAL" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Command" VerticalAlignment="Center" />
                        <TextBox x:Name="TerminalCommand" Grid.Column="1" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="Arguments" VerticalAlignment="Center" />
                        <TextBox x:Name="TerminalArgs" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                    </Grid>

                    <TextBlock Style="{StaticResource T.H2}" Text="STARTUP" />
                    <CheckBox x:Name="RunAtLogin" Content="Start the TaLLon listener when I sign in (stays dormant until the special key)" />
                </StackPanel>

                <StackPanel x:Name="PageKeys" MaxWidth="620" HorizontalAlignment="Left" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource T.H1}" Text="Key bindings" />
                    <TextBlock Style="{StaticResource T.Dim}" Text="Click a box and press a key (with Ctrl/Shift/Alt if you like). Toggle 'Special' to require the special key. Save applies instantly to the running listener." />
                    <StackPanel x:Name="KeysPanel" Margin="0,12,0,0" />
                </StackPanel>

                <StackPanel x:Name="PageLaunchers" MaxWidth="720" HorizontalAlignment="Left" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource T.H1}" Text="App launchers" />
                    <TextBlock Style="{StaticResource T.Dim}" Text="Bind a key combination to any program, file or URL. The menu (Special+Space) also lists everything installed, so only add favourites here." />
                    <StackPanel x:Name="LaunchersPanel" Margin="0,12,0,0" />
                    <Button x:Name="AddLauncher" Content="+ Add launcher" HorizontalAlignment="Left" Margin="0,10,0,0" Click="AddLauncher_Click" />
                </StackPanel>

                <StackPanel x:Name="PageAppearance" MaxWidth="620" HorizontalAlignment="Left" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource T.H1}" Text="Appearance &amp; layout" />
                    <TextBlock Style="{StaticResource T.H2}" Text="CANVAS BACKGROUND" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="BgImage" />
                        <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="BrowseBg_Click" />
                        <Button Grid.Column="2" Content="Default" Margin="6,0,0,0" Click="DefaultBg_Click" />
                    </Grid>
                    <Border Margin="0,10,0,0" Height="150" Width="267" HorizontalAlignment="Left" CornerRadius="6" BorderBrush="{StaticResource B.Line}" BorderThickness="1" ClipToBounds="True">
                        <Image x:Name="BgPreview" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Fallback colour" VerticalAlignment="Center" Width="200" />
                        <TextBox x:Name="BgColor" Width="120" />
                    </StackPanel>
                    <CheckBox x:Name="ShowHint" Content="Show the key hint in the corner of the canvas" Margin="0,8,0,0" />

                    <TextBlock Style="{StaticResource T.H2}" Text="TILING" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="Master area width" VerticalAlignment="Center" />
                        <Slider x:Name="MasterRatio" Grid.Column="1" Minimum="0.2" Maximum="0.8" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock x:Name="MasterRatioText" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Gap between windows (px)" VerticalAlignment="Center" />
                        <TextBox x:Name="Gap" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,3" />
                        <TextBlock Grid.Row="2" Text="Master windows" VerticalAlignment="Center" />
                        <TextBox x:Name="MasterCount" Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,3" />
                    </Grid>
                    <CheckBox x:Name="StartTiled" Content="Tile new windows automatically (off = windows open where they like until you press tile)" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel x:Name="PageAbout" MaxWidth="620" HorizontalAlignment="Left" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource T.H1}" Text="About TaLLon" />
                    <TextBlock Style="{StaticResource T.Dim}" Text="An on-demand window manager for Windows 11. Dormant until you press the special key; then the desktop becomes a canvas and windows tile vxwm-style." />
                    <TextBlock Style="{StaticResource T.H2}" Text="FILES" />
                    <TextBlock x:Name="ConfigPathText" Style="{StaticResource T.Dim}" />
                    <Button Content="Open config folder" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenFolder_Click" />
                    <TextBlock Style="{StaticResource T.H2}" Text="STATUS" />
                    <TextBlock x:Name="DaemonStatus" Style="{StaticResource T.Dim}" />
                    <TextBlock Style="{StaticResource T.H2}" Text="VERSION" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource T.Dim}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- bottom bar -->
        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource B.Bg0}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <TextBlock x:Name="Status" Style="{StaticResource T.Dim}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Revert" Margin="0,0,8,0" Click="Revert_Click" />
                    <Button Content="Save" Style="{StaticResource Btn.Primary}" Width="100" Click="Save_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
