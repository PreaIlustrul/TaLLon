<Window x:Class="TaLLon.App.Windows.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaLLon" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Background="#F0101418" Visibility="Hidden" Height="36">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFD6DCE2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <!-- explicit TextBlock: the app-wide implicit TextBlock style would otherwise replace the icon font -->
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD6DCE2" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BarIcon" TargetType="TextBlock" BasedOn="{StaticResource BarText}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="14,0,6,0" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="#FF2A3138" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- left: coordinates + mode -->
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE707;" Style="{StaticResource BarIcon}" Margin="0,0,6,0" Foreground="#FF4C9BE8" />
                <TextBlock x:Name="Coords" Style="{StaticResource BarText}" Text="(0, 0)" />
                <Border Background="#FF1E262E" CornerRadius="4" Padding="8,2" Margin="14,0,0,0">
                    <TextBlock x:Name="ModeText" Style="{StaticResource BarText}" Text="infinite" Foreground="#FF9AA6B2" />
                </Border>
            </StackPanel>

            <!-- centre: actions + clock -->
            <StackPanel x:Name="Center" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource BarButton}" Content="&#xE700;" ToolTip="Menu (Special+Space)" Click="Menu_Click" />
                <Button Style="{StaticResource BarButton}" Content="&#xE80F;" ToolTip="Go to (0, 0)" Click="Home_Click" />
                <Button Style="{StaticResource BarButton}" Content="&#xE713;" ToolTip="TaLLon settings" Click="Settings_Click" />
                <Button x:Name="OverviewBtn" Style="{StaticResource BarButton}" Content="&#xE8A9;" ToolTip="Overview (Alt+Tab)" Click="Overview_Click" />
                <Button Style="{StaticResource BarButton}" Content="&#xE8A1;" ToolTip="Switch mode (infinite / tiling)" Click="Mode_Click" />
                <Rectangle Width="1" Height="18" Fill="#FF2A3138" Margin="8,0" />
                <TextBlock x:Name="Clock" Style="{StaticResource BarText}" FontSize="13" Margin="4,0,8,0" />
            </StackPanel>

            <!-- right: status -->
            <StackPanel x:Name="Right" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock x:Name="WifiIcon" Text="&#xE701;" Style="{StaticResource BarIcon}" />
                <TextBlock x:Name="WifiText" Style="{StaticResource BarText}" Text="—" />
                <TextBlock x:Name="BtIcon" Text="&#xE702;" Style="{StaticResource BarIcon}" />
                <TextBlock x:Name="BtText" Style="{StaticResource BarText}" Text="—" />
                <TextBlock x:Name="VolIcon" Text="&#xE767;" Style="{StaticResource BarIcon}" />
                <TextBlock x:Name="VolText" Style="{StaticResource BarText}" Text="—" />
                <TextBlock x:Name="BatIcon" Text="&#xE83F;" Style="{StaticResource BarIcon}" />
                <TextBlock x:Name="BatText" Style="{StaticResource BarText}" Text="—" />
                <Button Style="{StaticResource BarButton}" Content="&#xE7E8;" ToolTip="Exit TaLLon (tap Special)" Margin="10,0,0,0" Click="Exit_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
